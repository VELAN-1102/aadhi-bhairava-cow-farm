generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?
  roleId        String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  activityLogs  ActivityLog[]
  auditLogs     AuditLog[]
  employees     Employee?
  expenses      Expense[]
  incomes       Income[]
  notifications Notification[]
  reports       Report[]
  role          Role           @relation(fields: [roleId], references: [id])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Employee {
  id          String       @id @default(uuid())
  userId      String?      @unique
  name        String
  email       String       @unique
  phone       String
  designation String
  department  String
  joinDate    DateTime
  salary      Decimal      @db.Decimal(10, 2)
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendance  Attendance[]
  user        User?        @relation(fields: [userId], references: [id])
  payrolls    Payroll[]
  tasks       Task[]
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  date       DateTime  @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("PRESENT")
  notes      String?
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Payroll {
  id             String    @id @default(uuid())
  employeeId     String
  payPeriodStart DateTime  @db.Date
  payPeriodEnd   DateTime  @db.Date
  basicSalary    Decimal   @db.Decimal(10, 2)
  allowances     Decimal   @default(0) @db.Decimal(10, 2)
  deductions     Decimal   @default(0) @db.Decimal(10, 2)
  netSalary      Decimal   @db.Decimal(10, 2)
  status         String    @default("PENDING")
  paymentDate    DateTime?
  createdAt      DateTime  @default(now())
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Task {
  id           String    @id @default(uuid())
  title        String
  description  String?
  assignedToId String
  status       String    @default("TODO")
  priority     String    @default("MEDIUM")
  dueDate      DateTime
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedTo   Employee  @relation(fields: [assignedToId], references: [id], onDelete: Cascade)
}

model CowBreed {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  cows        Cow[]
}

model Cow {
  id                String             @id @default(uuid())
  tagNumber         String             @unique
  name              String
  breedId           String
  gender            String             @default("FEMALE")
  dateOfBirth       DateTime
  weight            Decimal            @db.Decimal(6, 2)
  color             String
  status            String             @default("HEALTHY")
  purchaseDate      DateTime?
  purchasePrice     Decimal?           @db.Decimal(10, 2)
  insuranceNumber   String?
  fatherTag         String?
  motherTag         String?
  breedDetail       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  aiRecommendations AIRecommendation[]
  calvingHistories  CalvingHistory[]
  breed             CowBreed           @relation(fields: [breedId], references: [id])
  images            CowImage[]
  medicalRecords    MedicalRecord[]
  milkCollections   MilkCollection[]
  pregnancies       Pregnancy[]
  vaccinations      Vaccination[]
}

model CowImage {
  id        String   @id @default(uuid())
  cowId     String
  imageUrl  String
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())
  cow       Cow      @relation(fields: [cowId], references: [id], onDelete: Cascade)
}

model Vaccination {
  id               String    @id @default(uuid())
  cowId            String
  vaccineName      String
  administeredDate DateTime?
  dueDate          DateTime
  status           String    @default("PENDING")
  administeredBy   String?
  notes            String?
  cow              Cow       @relation(fields: [cowId], references: [id], onDelete: Cascade)
}

model MedicalRecord {
  id           String      @id @default(uuid())
  cowId        String
  date         DateTime
  diagnosis    String
  treatment    String
  doctorName   String
  prescription String?
  cost         Decimal     @default(0) @db.Decimal(10, 2)
  status       String      @default("CLOSED")
  notes        String?
  cow          Cow         @relation(fields: [cowId], references: [id], onDelete: Cascade)
  treatments   Treatment[]
}

model Disease {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  symptoms    String?
  severity    String      @default("LOW")
  treatments  Treatment[]
}

model Treatment {
  id              String        @id @default(uuid())
  medicalRecordId String
  diseaseId       String
  medicationName  String
  dosage          String
  startDate       DateTime
  endDate         DateTime
  notes           String?
  disease         Disease       @relation(fields: [diseaseId], references: [id])
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
}

model Pregnancy {
  id                  String           @id @default(uuid())
  cowId               String
  breedingDate        DateTime
  breedingMethod      String           @default("AI")
  bullTag             String?
  expectedCalvingDate DateTime
  status              String           @default("ACTIVE")
  notes               String?
  calvingHistories    CalvingHistory[]
  cow                 Cow              @relation(fields: [cowId], references: [id], onDelete: Cascade)
}

model CalvingHistory {
  id            String    @id @default(uuid())
  cowId         String
  pregnancyId   String
  calvingDate   DateTime
  calfGender    String    @default("FEMALE")
  calfTagNumber String?   @unique
  status        String    @default("ALIVE")
  notes         String?
  cow           Cow       @relation(fields: [cowId], references: [id], onDelete: Cascade)
  pregnancy     Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)
}

model MilkCollection {
  id             String        @id @default(uuid())
  cowId          String?
  quantity       Decimal       @db.Decimal(5, 2)
  shift          String
  date           DateTime      @db.Date
  fatPercentage  Decimal       @db.Decimal(4, 2)
  snfPercentage  Decimal       @db.Decimal(4, 2)
  temperature    Decimal?      @db.Decimal(4, 2)
  collectedBy    String?
  notes          String?
  cow            Cow?          @relation(fields: [cowId], references: [id])
  qualityRecords MilkQuality[]
}

model MilkQuality {
  id           String         @id @default(uuid())
  collectionId String
  fatPercent   Decimal        @db.Decimal(4, 2)
  snfPercent   Decimal        @db.Decimal(4, 2)
  density      Decimal        @db.Decimal(5, 4)
  acidity      Decimal?       @db.Decimal(3, 2)
  status       String         @default("GOOD")
  collection   MilkCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

model MilkSale {
  id            String   @id @default(uuid())
  customerId    String
  date          DateTime
  quantity      Decimal  @db.Decimal(6, 2)
  ratePerLiter  Decimal  @db.Decimal(5, 2)
  totalAmount   Decimal  @db.Decimal(10, 2)
  paymentStatus String   @default("UNPAID")
  invoiceId     String?  @unique
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice       Invoice? @relation(fields: [invoiceId], references: [id])
}

model FeedInventory {
  id               String    @id @default(uuid())
  name             String
  quantity         Decimal   @db.Decimal(10, 2)
  minQuantityAlert Decimal   @db.Decimal(10, 2)
  unitPrice        Decimal   @db.Decimal(8, 2)
  supplierId       String?
  lastRestocked    DateTime?
  expiryDate       DateTime?
  notes            String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
}

model MedicineInventory {
  id               String    @id @default(uuid())
  name             String
  batchNumber      String
  quantity         Int
  minQuantityAlert Int
  unitPrice        Decimal   @db.Decimal(8, 2)
  supplierId       String?
  lastRestocked    DateTime?
  expiryDate       DateTime?
  notes            String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
}

model Equipment {
  id              String    @id @default(uuid())
  name            String
  serialNumber    String?   @unique
  purchaseDate    DateTime
  cost            Decimal   @db.Decimal(10, 2)
  status          String    @default("OPERATIONAL")
  lastServiceDate DateTime?
  nextServiceDate DateTime?
}

model Supplier {
  id                  String              @id @default(uuid())
  name                String
  contactPerson       String?
  email               String?
  phone               String
  address             String?
  createdAt           DateTime            @default(now())
  feedInventories     FeedInventory[]
  invoices            Invoice[]
  medicineInventories MedicineInventory[]
  purchaseOrders      PurchaseOrder[]
}

model PurchaseOrder {
  id                   String    @id @default(uuid())
  supplierId           String
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime?
  totalAmount          Decimal   @db.Decimal(10, 2)
  status               String    @default("PENDING")
  items                String?
  supplier             Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String     @id @default(uuid())
  name      String
  email     String?    @unique
  phone     String
  address   String?
  createdAt DateTime   @default(now())
  incomes   Income[]
  invoices  Invoice[]
  milkSales MilkSale[]
}

model SalesOrder {
  id          String   @id @default(uuid())
  customerId  String
  orderDate   DateTime @default(now())
  status      String   @default("PENDING")
  totalAmount Decimal  @db.Decimal(10, 2)
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  invoiceDate   DateTime
  dueDate       DateTime
  totalAmount   Decimal   @db.Decimal(10, 2)
  paidAmount    Decimal   @default(0) @db.Decimal(10, 2)
  balanceAmount Decimal   @db.Decimal(10, 2)
  status        String    @default("UNPAID")
  customerId    String?
  supplierId    String?
  type          String
  createdAt     DateTime  @default(now())
  expenses      Expense[]
  incomes       Income[]
  customer      Customer? @relation(fields: [customerId], references: [id])
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  milkSales     MilkSale?
}

model Expense {
  id           String   @id @default(uuid())
  category     String
  amount       Decimal  @db.Decimal(10, 2)
  date         DateTime @db.Date
  description  String?
  invoiceId    String?
  recordedById String
  invoice      Invoice? @relation(fields: [invoiceId], references: [id])
  recordedBy   User     @relation(fields: [recordedById], references: [id])
}

model Income {
  id           String    @id @default(uuid())
  source       String
  amount       Decimal   @db.Decimal(10, 2)
  date         DateTime  @db.Date
  description  String?
  invoiceId    String?
  recordedById String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  invoice      Invoice?  @relation(fields: [invoiceId], references: [id])
  recordedBy   User      @relation(fields: [recordedById], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id            String   @id @default(uuid())
  name          String
  type          String
  url           String
  generatedById String
  createdAt     DateTime @default(now())
  generatedBy   User     @relation(fields: [generatedById], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String
  activityType String
  description  String
  timestamp    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  group String
}

model Weather {
  id          String   @id @default(uuid())
  date        DateTime @unique @db.Date
  temperature Decimal  @db.Decimal(4, 2)
  humidity    Decimal  @db.Decimal(4, 2)
  rainfall    Decimal  @db.Decimal(4, 2)
  forecast    String
}

model AIRecommendation {
  id              String   @id @default(uuid())
  cowId           String?
  category        String
  recommendation  String
  confidenceScore Decimal  @db.Decimal(3, 2)
  createdAt       DateTime @default(now())
  cow             Cow?     @relation(fields: [cowId], references: [id])
}
